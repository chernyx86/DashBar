{
  "name": "DashBar pilot",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "DashBar",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt"
}
